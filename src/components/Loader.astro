---
/**
 * First-visit loader: a progress ring, a counting percentage and a double
 * wipe exit, in the page's own accent colour so it belongs to whichever quiz
 * you land on. Shown once per browser session — a static site does a full page
 * load on every click, and nobody wants a curtain on every navigation.
 */
---

<div id="qz-loader-trail" class="qz-trail" aria-hidden="true"></div>

<div
  id="qz-loader"
  class="qz-loader"
  role="status"
  aria-live="polite"
  aria-label="Loading Quizzy"
>
  <div class="qz-loader__inner">
    <div class="qz-loader__ring">
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <circle class="qz-loader__track" cx="60" cy="60" r="54"></circle>
        <circle id="qz-loader-bar" class="qz-loader__bar" cx="60" cy="60" r="54"
        ></circle>
      </svg>
      <span class="qz-loader__count">
        <span id="qz-loader-num">0</span><span class="qz-loader__pct">%</span>
      </span>
    </div>

    <p class="qz-loader__word display">Quizzy</p>
    <p class="qz-loader__label label">Warming up the questions</p>
  </div>
</div>

<noscript>
  <style>
    #qz-loader,
    #qz-loader-trail {
      display: none;
    }
  </style>
</noscript>

<style is:global>
  html.qz-loading,
  html.qz-loading body {
    overflow: hidden;
  }

  html.qz-loader-skip #qz-loader,
  html.qz-loader-skip #qz-loader-trail {
    display: none;
  }
</style>

<style>
  .qz-loader,
  .qz-trail {
    position: fixed;
    inset: 0;
    will-change: transform;
  }

  .qz-loader {
    z-index: 210;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--ink);
  }

  .qz-loader::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 50% at 50% 45%,
      color-mix(in oklab, var(--accent) 12%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .qz-trail {
    z-index: 205;
    background: var(--accent);
  }

  .qz-loader__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 22px;
    text-align: center;
  }

  .qz-loader__ring {
    position: relative;
    width: clamp(116px, 20vw, 156px);
    aspect-ratio: 1;
  }

  .qz-loader__ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .qz-loader__track,
  .qz-loader__bar {
    fill: none;
    stroke-width: 2.5;
  }

  .qz-loader__track {
    stroke: var(--line);
  }

  .qz-loader__bar {
    stroke: var(--accent);
    stroke-linecap: round;
  }

  .qz-loader__count {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    font-family: var(--font-display, inherit);
    font-size: clamp(34px, 6vw, 46px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .qz-loader__pct {
    font-family: var(--font-sans, inherit);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .qz-loader__word {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .qz-loader__label {
    color: var(--ink-muted);
  }
</style>

<script>
  import { gsap } from "gsap";

  const root = document.documentElement;
  const loader = document.getElementById("qz-loader");
  const trail = document.getElementById("qz-loader-trail");

  function finish() {
    if (loader) loader.style.display = "none";
    if (trail) trail.style.display = "none";
    root.classList.remove("qz-loading");
    try {
      sessionStorage.setItem("qz-loader-seen", "1");
    } catch {
      /* private mode: the loader simply shows again next time */
    }
  }

  if (loader && trail && !root.classList.contains("qz-loader-skip")) {
    root.classList.add("qz-loading");

    const num = document.getElementById("qz-loader-num");
    const bar = document.getElementById("qz-loader-bar");
    const ring = loader.querySelector(".qz-loader__ring");
    const fade = loader.querySelectorAll(".qz-loader__word, .qz-loader__label");
    const length = 2 * Math.PI * 54;
    const progress = { value: 0 };

    if (bar) {
      bar.style.strokeDasharray = `${length}`;
      bar.style.strokeDashoffset = `${length}`;
    }

    gsap
      .timeline({
        defaults: { ease: "power2.out" },
        onComplete: finish,
      })
      .to(progress, {
        value: 100,
        duration: 1.05,
        ease: "power2.inOut",
        onUpdate() {
          if (num) num.textContent = String(Math.round(progress.value));
          if (bar) {
            bar.style.strokeDashoffset = `${length * (1 - progress.value / 100)}`;
          }
        },
      })
      .to(
        [ring, ...fade],
        { y: -14, opacity: 0, duration: 0.36, stagger: 0.05, ease: "power2.in" },
        "-=0.12",
      )
      .to(loader, { yPercent: -100, duration: 0.95, ease: "power4.inOut" }, "<")
      .to(
        trail,
        { yPercent: -100, duration: 0.95, ease: "power4.inOut" },
        "<0.12",
      );

    // Safety net: if anything above throws, don't leave the page covered.
    window.setTimeout(() => {
      if (root.classList.contains("qz-loading")) finish();
    }, 5000);
  } else {
    finish();
  }
</script>
