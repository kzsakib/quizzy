---
/**
 * First-visit loader: an orbiting inset-glow orb with a breathing wordmark,
 * a counting percentage and a double wipe exit, in the page's own accent colour
 * so it belongs to whichever quiz you land on. Shown once per browser session —
 * a static site does a full page load on every click, and nobody wants a
 * curtain on every navigation.
 */
const letters = [..."QUIZZY"];
---

<div id="qz-loader-trail" class="qz-trail" aria-hidden="true"></div>

<div
  id="qz-loader"
  class="qz-loader"
  role="status"
  aria-live="polite"
  aria-label="Loading Quizzy"
>
  <div class="qz-loader__inner">
    <div class="qz-loader__orb" aria-hidden="true">
      <div class="qz-loader__spin"></div>
      {
        letters.map((letter, index) => (
          <span class="qz-loader__letter" style={`--i: ${index}`}>
            {letter}
          </span>
        ))
      }
    </div>

    <p class="qz-loader__label label">
      <span id="qz-loader-num">0</span>% · Warming up the questions
    </p>
  </div>
</div>

<noscript>
  <style>
    #qz-loader,
    #qz-loader-trail {
      display: none;
    }
  </style>
</noscript>

<style is:global>
  html.qz-loading,
  html.qz-loading body {
    overflow: hidden;
  }

  html.qz-loader-skip #qz-loader,
  html.qz-loader-skip #qz-loader-trail {
    display: none;
  }
</style>

<style>
  .qz-loader,
  .qz-trail {
    position: fixed;
    inset: 0;
    will-change: transform;
  }

  .qz-loader {
    z-index: 210;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--ink);
  }

  .qz-loader::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 50% at 50% 45%,
      color-mix(in oklab, var(--accent) 12%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .qz-trail {
    z-index: 205;
    background: var(--accent);
  }

  .qz-loader__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 26px;
    text-align: center;
  }

  .qz-loader__orb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(170px, 24vw, 210px);
    aspect-ratio: 1;
    border-radius: 50%;
    user-select: none;
  }

  /* The glowing ring: three inset shadows on a transparent disc, rotated
     continuously so the light sweeps around the wordmark. */
  .qz-loader__spin {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: transparent;
    animation: qz-orb-rotate 2s linear infinite;
    will-change: transform;
  }

  @keyframes qz-orb-rotate {
    0% {
      transform: rotate(90deg);
      box-shadow:
        0 10px 20px 0 rgba(255, 255, 255, 0.85) inset,
        0 20px 30px 0 color-mix(in oklab, var(--accent) 85%, #fff) inset,
        0 60px 60px 0 color-mix(in oklab, var(--accent) 55%, #000) inset;
    }
    50% {
      transform: rotate(270deg);
      box-shadow:
        0 10px 20px 0 rgba(255, 255, 255, 0.85) inset,
        0 20px 10px 0 color-mix(in oklab, var(--accent) 70%, #fff) inset,
        0 40px 60px 0 color-mix(in oklab, var(--accent) 35%, #000) inset;
    }
    100% {
      transform: rotate(450deg);
      box-shadow:
        0 10px 20px 0 rgba(255, 255, 255, 0.85) inset,
        0 20px 30px 0 color-mix(in oklab, var(--accent) 85%, #fff) inset,
        0 60px 60px 0 color-mix(in oklab, var(--accent) 55%, #000) inset;
    }
  }

  .qz-loader__letter {
    position: relative;
    z-index: 1;
    display: inline-block;
    font-family: var(--font-display, inherit);
    font-size: clamp(20px, 3.2vw, 26px);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    opacity: 0.4;
    transform: translateY(0);
    animation: qz-letter-breathe 2s infinite;
    animation-delay: calc(var(--i) * 0.1s);
    will-change: transform, opacity;
  }

  @keyframes qz-letter-breathe {
    0%,
    100% {
      opacity: 0.4;
      transform: translateY(0) scale(1);
    }
    20% {
      opacity: 1;
      transform: scale(1.15);
    }
    40% {
      opacity: 0.7;
      transform: translateY(0) scale(1);
    }
  }

  .qz-loader__label {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { gsap } from "gsap";

  const root = document.documentElement;
  const loader = document.getElementById("qz-loader");
  const trail = document.getElementById("qz-loader-trail");

  function finish() {
    if (loader) loader.style.display = "none";
    if (trail) trail.style.display = "none";
    root.classList.remove("qz-loading");
    try {
      sessionStorage.setItem("qz-loader-seen", "1");
    } catch {
      /* private mode: the loader simply shows again next time */
    }
  }

  if (loader && trail && !root.classList.contains("qz-loader-skip")) {
    root.classList.add("qz-loading");

    const num = document.getElementById("qz-loader-num");
    const orb = loader.querySelector(".qz-loader__orb");
    const label = loader.querySelector(".qz-loader__label");
    const progress = { value: 0 };

    gsap
      .timeline({
        defaults: { ease: "power2.out" },
        onComplete: finish,
      })
      .to(progress, {
        value: 100,
        duration: 1.15,
        ease: "power2.inOut",
        onUpdate() {
          if (num) num.textContent = String(Math.round(progress.value));
        },
      })
      .to(
        [orb, label],
        { y: -14, opacity: 0, duration: 0.36, stagger: 0.05, ease: "power2.in" },
        "-=0.12",
      )
      .to(loader, { yPercent: -100, duration: 0.95, ease: "power4.inOut" }, "<")
      .to(
        trail,
        { yPercent: -100, duration: 0.95, ease: "power4.inOut" },
        "<0.12",
      );

    // Safety net: if anything above throws, don't leave the page covered.
    window.setTimeout(() => {
      if (root.classList.contains("qz-loading")) finish();
    }, 5000);
  } else {
    finish();
  }
</script>
