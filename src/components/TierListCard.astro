---
import { onAccentInk } from "../lib/accents";
import type { TierList } from "../lib/tierlists-types";
import { siteHref } from "../lib/url";

interface Props {
  list: TierList;
  /** Narrower type and copy for the home-page strip. */
  compact?: boolean;
  class?: string;
}

const { list, compact = false, class: className = "" } = Astro.props;
const ink = onAccentInk(list.accent);
---

<article
  class:list={[
    "group relative isolate flex h-full flex-col overflow-hidden rounded-[var(--r-tile)] border border-line/80 bg-surface transition-transform duration-300 hover:-translate-y-1",
    className,
  ]}
>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 z-10 h-1.5"
    style={`background: var(--accent-${list.accent})`}
  />

  <div class:list={["flex flex-1 flex-col", compact ? "p-4" : "p-5 sm:p-6"]}>
    <div class="flex items-start justify-between gap-3">
      <p class="label text-[var(--ink-muted)]">
        {list.items.length} items · {list.tiers.length} tiers
      </p>
      <span
        class:list={[
          "grid shrink-0 place-items-center rounded-full",
          compact ? "size-8 text-base" : "size-10 text-lg",
        ]}
        style={`background: var(--accent-${list.accent}); color: ${ink}`}
        aria-hidden="true">{list.emoji}</span
      >
    </div>

    <h3
      class:list={[
        "display mt-4 text-balance leading-[0.94]",
        compact ? "text-[19px]" : "text-[clamp(23px,2.6vw,30px)]",
      ]}
    >
      {list.title}
    </h3>

    {
      !compact ? (
        <p class="mt-3 text-sm leading-snug text-[var(--ink-soft)]">{list.dek}</p>
      ) : null
    }

    <ul class="mt-auto flex flex-wrap gap-1.5 pt-5" role="list">
      {list.tiers.map((tier) => (
        <li
          class="label flex items-center gap-1.5 rounded-[var(--r-pill)] bg-surface-2 px-2.5 py-1.5 text-[10px] text-[var(--ink-soft)]"
        >
          <span
            class="inline-block size-1.5 shrink-0 rounded-full"
            style={`background: var(--accent-${tier.accent})`}
            aria-hidden="true"
          />
          {tier.name}
        </li>
      ))}
    </ul>
  </div>

  <div class="flex items-center justify-between gap-3 border-t border-line/70 px-5 py-3">
    <span class="label text-[var(--ink-muted)]">{list.category}</span>
    <span
      aria-hidden="true"
      class="grid size-8 place-items-center rounded-full bg-ink text-[var(--on-ink)] transition-transform duration-300 group-hover:rotate-45"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </span>
  </div>

  <a
    href={siteHref(`/tierlists/${list.slug}/`)}
    class="absolute inset-0 rounded-[var(--r-tile)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
  >
    <span class="sr-only">Open the {list.title} tier list</span>
  </a>
</article>
