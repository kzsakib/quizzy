---
import { categories } from "../lib/quizzes";
import { siteHref } from "../lib/url";

const year = new Date().getFullYear();
const columns = [
  {
    title: "Categories",
    links: categories.map((category) => ({
      label: category.name,
      href: siteHref(`/category/${category.slug}/`),
    })),
  },
  {
    title: "Browse",
    links: [
      { label: "Trending", href: siteHref("/#trending") },
      { label: "Fresh today", href: siteHref("/#fresh") },
      { label: "Random quiz", href: siteHref("/#fresh") },
    ],
  },
  {
    title: "About",
    links: [
      { label: "How scoring works", href: siteHref("/#categories") },
      { label: "Browse quizzes", href: siteHref("/#fresh") },
      { label: "Say hi", href: "mailto:hi@quizzy.example" },
    ],
  },
];
---

<footer class="mt-24 border-t border-line/80 bg-bg pb-6 pt-14">
  <div class="container-page">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="max-w-xs">
        <p class="display text-[34px] leading-none">Quizzy</p>
        <p class="mt-3 text-sm leading-relaxed text-[var(--ink-soft)]">
          Personality quizzes for people who have opinions about everything.
          Pick a vibe, answer honestly, get roasted gently.
        </p>
        <p class="label mt-5 text-[var(--ink-muted)]">No accounts. No data hoarding.</p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <p class="label text-[var(--ink-muted)]">{column.title}</p>
            <ul class="mt-4 space-y-2.5" role="list">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-[var(--ink-strong)] transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line/70 pt-6">
      <p class="label text-[var(--ink-muted)]">© {year} Quizzy — made for fun only</p>
      <p class="label text-[var(--ink-muted)]">Built with Astro, GSAP & too much coffee</p>
    </div>
  </div>

  <!-- Oversized wordmark. Clip only sideways so the letterforms are never
       cut off at the bottom. -->
  <div class="mt-8 select-none overflow-x-clip pb-2" aria-hidden="true">
    <div
      class="display flex justify-between whitespace-nowrap px-2 text-[clamp(88px,23vw,340px)] leading-[1.06] text-[var(--ink-strong)]"
    >
      <span>Quizzy</span>
      <span class="hover:text-yellow transition-colors duration-300">☺</span>
    </div>
  </div>
</footer>
