---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import QuizCard from "../../../components/QuizCard.astro";
import { quizzes, relatedQuizzes } from "../../../lib/quizzes";
import type { Quiz } from "../../../lib/scoring";
import { siteHref } from "../../../lib/url";

export function getStaticPaths() {
  return quizzes.map((quiz) => ({
    params: { slug: quiz.slug },
    props: { quiz },
  }));
}

interface Props {
  quiz: Quiz;
}

const { quiz } = Astro.props as Props;
const related = relatedQuizzes(quiz.slug, 3);
---

<BaseLayout
  title={`${quiz.title} — Quizzy`}
  description={`${quiz.dek} ${quiz.questions.length} questions, about ${quiz.minutes} minutes, no sign-up.`}
  accent={quiz.accent}
>
  <section class="container-page pt-2">
    <a href={siteHref("/")} class="label text-[var(--ink-muted)] hover:text-ink">← All quizzes</a>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-start">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="grid size-14 place-items-center rounded-full bg-[var(--accent)] text-2xl"
            aria-hidden="true">{quiz.emoji}</span
          >
          <span class="label rounded-[var(--r-pill)] border border-line px-3 py-2 text-[var(--ink-soft)]"
            >{quiz.category}</span
          >
          <span class="label text-[var(--ink-muted)]"
            >{quiz.questions.length} questions · {quiz.minutes} min</span
          >
        </div>

        <h1
          class="display mt-6 max-w-[16ch] text-[clamp(42px,8vw,96px)] leading-[0.86]"
        >
          {quiz.title}
        </h1>

        <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-[var(--ink-soft)]">
          {quiz.dek}
        </p>

        <a
          href={siteHref(`/quiz/${quiz.slug}/take/`)}
          class="label mt-8 inline-flex items-center gap-2 rounded-[var(--r-pill)] bg-ink px-6 py-4 text-[var(--on-ink)] transition-transform duration-200 hover:-translate-y-0.5"
        >
          Start the quiz
          <svg
            viewBox="0 0 24 24"
            class="size-3.5"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>

        <p class="label mt-4 text-[var(--ink-muted)]">
          No email. No account. Your answers stay in this tab.
        </p>
      </div>

      <aside
        class="rounded-[var(--r-tile)] border border-line bg-surface p-6"
        aria-labelledby="outcomes-heading"
      >
        <p id="outcomes-heading" class="label text-[var(--ink-muted)]">No spoilers</p>
        <p class="display mt-4 text-[clamp(24px,3.4vw,34px)] leading-[0.95]">
          You meet your result at the end.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-[var(--ink-soft)]">
          Not before. That's the whole point. Answer honestly and we'll show
          you where you landed, plus how the rest of the mix scored.
        </p>

        <ul
          class="mt-6 space-y-3 border-t border-line/70 pt-5 text-sm text-[var(--ink-soft)]"
          role="list"
        >
          <li class="flex items-baseline justify-between gap-4">
            <span>Questions</span>
            <span class="label text-[var(--ink-muted)]">{quiz.questions.length}</span>
          </li>
          <li class="flex items-baseline justify-between gap-4">
            <span>Question types</span>
            <span class="label text-[var(--ink-muted)]">
              {
                [
                  ...new Set(
                    quiz.questions.map((question) => question.type),
                  ),
                ].length
              } kinds
            </span>
          </li>
          <li class="flex items-baseline justify-between gap-4">
            <span>Format</span>
            <span class="label text-[var(--ink-muted)]">One page</span>
          </li>
          <li class="flex items-baseline justify-between gap-4">
            <span>Result</span>
            <span class="label text-[var(--ink-muted)]">After the last answer</span>
          </li>
        </ul>

        <div class="mt-6 border-t border-line/70 pt-5">
          <p class="label text-[var(--ink-muted)]">How it works</p>
          <ol class="mt-3 space-y-2 text-sm text-[var(--ink-soft)]">
            <li>Answer every question, in any order.</li>
            <li>Change anything until you submit.</li>
            <li>Your result and full breakdown appear at the end.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section
        class="container-page mt-20"
        aria-labelledby="related-heading"
      >
        <div class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
          <h2 id="related-heading" class="label text-[var(--ink-muted)]">
            If you liked this
          </h2>
          <a href={siteHref("/#fresh")} class="label text-[var(--ink-muted)] hover:text-ink">
            See everything
          </a>
        </div>
        <div class="mt-6 grid gap-[var(--bento-gap)] sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <div data-reveal class="h-full">
              <QuizCard quiz={item} class="h-full" />
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
